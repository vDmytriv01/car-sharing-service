#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/car-sharing-bootstrap.log | logger -t car-sharing-bootstrap -s 2>/dev/console) 2>&1

systemd-run \
  --unit car-sharing-auto-terminate \
  --on-active=${auto_terminate_minutes}min \
  /sbin/shutdown -h now

on_error() {
  trap - ERR
  systemd-run \
    --unit car-sharing-error-terminate \
    --on-active=15min \
    /sbin/shutdown -h now || /sbin/shutdown -h now
}
trap on_error ERR

dnf install -y docker git
systemctl enable --now amazon-ssm-agent
systemctl enable --now docker

install -d -m 0700 /opt/car-sharing
git clone --depth 1 --branch "${repository_branch}" "${repository_url}" /opt/car-sharing/source
test "$(git -C /opt/car-sharing/source rev-parse HEAD)" = "${repository_ref}"

read_parameter() {
  aws ssm get-parameter \
    --region "${aws_region}" \
    --name "$1" \
    --with-decryption \
    --query Parameter.Value \
    --output text
}

stripe_secret_key="$(read_parameter "${parameter_prefix}/stripe-secret-key")"
stripe_webhook_secret="$(read_parameter "${parameter_prefix}/stripe-webhook-secret")"
telegram_bot_token="$(read_parameter "${parameter_prefix}/telegram-bot-token")"
telegram_chat_id="$(read_parameter "${parameter_prefix}/telegram-chat-id")"
manager_email="$(read_parameter "${parameter_prefix}/manager-email")"
manager_first_name="$(read_parameter "${parameter_prefix}/manager-first-name")"
manager_last_name="$(read_parameter "${parameter_prefix}/manager-last-name")"
manager_password="$(read_parameter "${parameter_prefix}/manager-password")"

install -m 0600 /dev/null /opt/car-sharing/app.env
{
  printf '%s\n' \
    'APP_BASE_URL=https://${public_hostname}' \
    'BOOTSTRAP_MANAGER_ENABLED=true' \
    'DB_URL=jdbc:mysql://mysql:3306/car_sharing' \
    'DB_USERNAME=car_sharing' \
    'JWT_EXPIRATION=1h' \
    'JWT_ISSUER=car-sharing-service' \
    'OVERDUE_NOTIFICATION_CRON=0 0 9 * * *' \
    'OVERDUE_NOTIFICATION_ZONE=Europe/Warsaw' \
    'SPRING_PROFILES_ACTIVE=prod'
  printf 'DB_PASSWORD=%s\n' '${mysql_password}'
  printf 'JWT_SECRET=%s\n' '${jwt_secret}'
  printf 'STRIPE_SECRET_KEY=%s\n' "$stripe_secret_key"
  printf 'STRIPE_WEBHOOK_SECRET=%s\n' "$stripe_webhook_secret"
  printf 'TELEGRAM_BOT_TOKEN=%s\n' "$telegram_bot_token"
  printf 'TELEGRAM_CHAT_ID=%s\n' "$telegram_chat_id"
  printf 'BOOTSTRAP_MANAGER_EMAIL=%s\n' "$manager_email"
  printf 'BOOTSTRAP_MANAGER_FIRST_NAME=%s\n' "$manager_first_name"
  printf 'BOOTSTRAP_MANAGER_LAST_NAME=%s\n' "$manager_last_name"
  printf 'BOOTSTRAP_MANAGER_PASSWORD=%s\n' "$manager_password"
} >/opt/car-sharing/app.env

cat >/opt/car-sharing/Caddyfile <<'CADDY'
${public_hostname} {
  encode zstd gzip
  reverse_proxy car-sharing-service:8080
}
CADDY

docker network create car-sharing
docker volume create car-sharing-mysql
docker volume create car-sharing-caddy-data
docker volume create car-sharing-caddy-config

docker run --detach \
  --name mysql \
  --network car-sharing \
  --restart unless-stopped \
  --env MYSQL_DATABASE=car_sharing \
  --env MYSQL_USER=car_sharing \
  --env MYSQL_PASSWORD="${mysql_password}" \
  --env MYSQL_ROOT_PASSWORD="${mysql_root_password}" \
  --volume car-sharing-mysql:/var/lib/mysql \
  mysql:8.4

for attempt in $(seq 1 60); do
  if docker exec mysql mysqladmin ping --host localhost --user root --password="${mysql_root_password}" --silent; then
    break
  fi
  sleep 5
done

docker exec mysql mysqladmin ping --host localhost --user root --password="${mysql_root_password}" --silent
docker build --tag car-sharing-service:portfolio /opt/car-sharing/source

docker run --detach \
  --name car-sharing-service \
  --network car-sharing \
  --restart unless-stopped \
  --env-file /opt/car-sharing/app.env \
  car-sharing-service:portfolio

for attempt in $(seq 1 80); do
  if docker exec car-sharing-service wget --quiet --tries=1 --spider http://localhost:8080/actuator/health; then
    break
  fi
  sleep 15
done

docker exec car-sharing-service wget --quiet --tries=1 --spider http://localhost:8080/actuator/health

docker run --detach \
  --name caddy \
  --network car-sharing \
  --restart unless-stopped \
  --publish 80:80 \
  --publish 443:443 \
  --volume /opt/car-sharing/Caddyfile:/etc/caddy/Caddyfile:ro \
  --volume car-sharing-caddy-data:/data \
  --volume car-sharing-caddy-config:/config \
  caddy:2.10-alpine

trap - ERR
